{
  "name": "d20-synth-server",
  "version": "1.1.0",
  "private": true,
  "description": "Backend for the D20 Synth Workbench / drum sequencer: accounts, cloud project storage, share links.",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "build": "node scripts/build.mjs",
    "test": "node test/e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "express": "^4.21.2",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
