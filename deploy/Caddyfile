# Caddy obtains and renews Let's Encrypt certificates automatically (HTTP-01),
# so no DNS API access is needed. DOMAIN and ACME_EMAIL come from deploy/.env.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 11MB
	}
}

# Optional: redirect www to the bare domain (only if DOMAIN is the apex and a www record exists).
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
