# Copy to deploy/.env on the server and fill in. Never commit the real .env.

# Public hostname the app is served on (apex or subdomain), e.g. drums.example.com
DOMAIN=drums.example.com

# Contact email for Let's Encrypt expiry notices
ACME_EMAIL=you@example.com

# Session signing key. Generate with:  openssl rand -hex 32
SESSION_SECRET=replace-me

# Optional
MAX_PROJECTS_PER_USER=200

# GoDaddy DNS API (only used by deploy/godaddy-dns.sh; works only if the account
# qualifies: 10+ domains or an active Discount Domain Club plan)
GODADDY_KEY=
GODADDY_SECRET=
